         vc.NetworkOwner = string.Empty;
         vc.TelephonicArea = string.Empty;
         vc.MediaType = string.Empty;
         vc.Rede = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].Rede : "N/A";
         vc.IdTecnologia = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].IdTecnologia : 0;
         vc.DescTecnologia = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].DescTecnologia : "N/A";
         vc.DescricaoCompleta = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].DescricaoCompleta : "N/A";
         vc.QtdeArmario = string.Empty;
         vc.QtdeLinhaTelefonica = string.Empty;
         vc.TecnologiaDeAcesso = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].DescTecnologia : "N/A";
         vc.VelocidadeMaximaDisponivel = string.Empty;
         vc.Logradouro = retorno.Logradouro;
         vc.Municipio = retorno.Municipio;
