             DescricaoCompleta = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].DescricaoCompleta : "N/A",
             Rede = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].Rede : "N/A",
             QtdeArmario = string.Empty,
             QtdeLinhaTelefonica = string.Empty,
             TecnologiaDeAcesso = retorno.Coberturas.Count > 0 ? retorno.Coberturas[0].DescTecnologia : "N/A",
             VelocidadeMaximaDisponivel = string.Empty,
             Critica = "Venda na mancha.",
             DisponibilidadeDetalhes = new List<DisponibilidadeDetalhe>
             {
                 new DisponibilidadeDetalhe { Indice = 1, DescTecnologia = string.Empty, QtdePortaLivre = string.Empty}
