     if (!retorno.HasDisponibilidade && retorno.HasCobertura)
     {
         // Encontra todos os proprietários de rede não vazios no conjunto de dados techAddress,
         // converte-os para maiúsculas e remove duplicatas, criando uma lista de proprietários de rede distintos.
         var distinctNetworkOwners = retorno.Coberturas.FindAll(
             f => !string.IsNullOrEmpty(f.Rede))
             .Select(ga => ga.Rede.ToUpper()).Distinct().ToList();

         municipioPrio.TemVivo1 = Convert.ToBoolean(distinctNetworkOwners.Where(value => value.StartsWith("VIVO1")).Count());
         municipioPrio.TemVivo2 = Convert.ToBoolean(distinctNetworkOwners.Where(value => value.StartsWith("VIVO2")).Count());
         municipioPrio.TemFibrasil = Convert.ToBoolean(distinctNetworkOwners.Where(value => value.StartsWith("FIBRASIL")).Count());
         municipioPrio.TemATC = Convert.ToBoolean(distinctNetworkOwners.Where(value => value.StartsWith("ATC")).Count());
     }

     var DexParaRetorno = _produtoRepository.GetMunicipioPrioRegra(municipioPrio);

     if (retorno.HasDisponibilidade)
     {
         foreach (var item in DexParaRetorno)
         {
             //Se encontrar os cenário compativeis, marca como visivel
             for (int i = 0; i < retorno.Disponibilidades.Count; i++)
             {
                 if (retorno.Disponibilidades[i].IdTecnologia == item.IdTecnologia &&
                     retorno.Disponibilidades[i].Rede == item.Rede)
                 {
                     retorno.Disponibilidades[i].IsVisible = true;
                 }
             }
         }

         //REMOVE O QUE NAO FOR PRA MOSTRAR DE ACORDO COM A REGRA COMERCIAL
         retorno.Disponibilidades.RemoveAll(disponibilidade => !disponibilidade.IsVisible);

     }
     else if (retorno.HasCobertura)
     {
         //ORDENA POR TECNOLOGIA, ASSIM COMEÇA PRIMEIRO PELO GPON QUE É O ID 1.
         foreach (var item in DexParaRetorno.OrderBy(X => X.IdTecnologia))
         {
             //Se encontrar os cenário compativeis, marca como visivel
             for (int i = 0; i < retorno.Coberturas.Count; i++)
             {
                 if (retorno.Coberturas[i].IdTecnologia == item.IdTecnologia &&
                     retorno.Coberturas[i].Rede == item.Rede)
                 {
                     retorno.Coberturas[i].IsVisible = true;
                 }
             }
         }

         //REMOVE O QUE NAO FOR PRA MOSTRAR DE ACORDO COM A REGRA COMERCIAL

         //SE TEM GPON, REMOVER METALICO
         if (retorno.Coberturas.FindAll(f => f.IdTecnologia == (int)Tecnologia.GPON).Count > 0)
